# Example environment file for local development
# Copy this to .env.local and customize as needed

# Database (matches docker-compose.local.yml)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/digger?sslmode=disable

# Backend API
PORT=3000
ALLOW_DIRTY=true
GIN_MODE=debug

# UI Settings
ORCHESTRATOR_BACKEND_URL=http://localhost:3000
ORCHESTRATOR_BACKEND_SECRET=local-dev-secret

# WorkOS Authentication (Optional - leave empty for local dev without auth)
WORKOS_REDIRECT_URI=http://localhost:3030/api/auth/callback
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=change-me-in-production

# GitHub Integration (if testing GitHub features)
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_WEBHOOK_SECRET=

# Background Jobs (Optional)
# BACKGROUND_JOBS_CLIENT_TYPE=local
